#!/bin/bash
# Fractal override of /usr/share/omarchy/bin/omarchy-launch-screensaver. Linked into
# ~/.local/bin (which precedes /usr/share/omarchy/bin on PATH) by the fractal-shell
# hook only while the fractal theme is active, and removed again on any other theme.
# On fractal: the Buddha + breathing aura, fullscreen, no text. Otherwise: stock.
SS="$HOME/.config/omarchy/themes/fractal/aura/fractal-screensaver"
STOCK=/usr/share/omarchy/bin/omarchy-launch-screensaver
if [[ $(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null) != fractal || ! -x $SS ]] ||
  ! command -v quickshell >/dev/null; then
  exec "$STOCK" "$@"
fi

# Exit early if screensaver is already running
pgrep -f '[o]rg.omarchy.screensaver' && exit 0

# Allow screensaver to be turned off but also force started
if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

setsid -f "$SS" org.omarchy.screensaver >/dev/null 2>&1 </dev/null
